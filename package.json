{
  "name": "blueprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm routes:generate && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "pnpm routes:generate && tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:browser-image": "node scripts/check-browser-image.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:e2e-categories": "node scripts/check-e2e-categories.mjs",
    "check:unit-categories": "node scripts/check-unit-categories.mjs",
    "test:guardrails": "node --test scripts/*.test.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:foundations": "vitest run --project foundations",
    "test:unit:data": "vitest run --project data",
    "test:unit:ui": "vitest run --project ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test e2e/workspace.spec.ts e2e/projects.spec.ts e2e/query-cache.spec.ts e2e/localization.spec.ts e2e/design-visual.spec.ts e2e/accessibility.spec.ts e2e/unsaved-changes.spec.ts e2e/app-recovery.spec.ts e2e/browser-compatibility.spec.ts",
    "test:e2e:samples": "playwright test e2e/commerce.spec.ts e2e/analytics-inbox.spec.ts e2e/workspace-users.spec.ts",
    "test:e2e:workspace": "playwright test e2e/workspace.spec.ts",
    "test:e2e:projects": "playwright test e2e/projects.spec.ts",
    "test:e2e:cache": "playwright test e2e/query-cache.spec.ts",
    "test:e2e:commerce": "playwright test e2e/commerce.spec.ts",
    "test:e2e:analytics-inbox": "playwright test e2e/analytics-inbox.spec.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm check:e2e-categories && pnpm check:unit-categories && pnpm check:page-specs && pnpm check:docs && pnpm check:browser-image",
    "check:ci": "pnpm check && pnpm test:guardrails && pnpm test:unit && pnpm build && pnpm check:bundle-budget",
    "prepare": "husky",
    "ui:add": "shadcn add",
    "ui:mcp": "shadcn mcp",
    "check:mcp": "node scripts/check-mcp.mjs",
    "routes:generate": "tsr generate",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "check:page-specs": "node scripts/check-page-specs.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "i18next": "26.7.1",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "msw": "3.0.4",
    "pretendard": "1.3.9",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0 <27",
    "pnpm": ">=11 <12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
