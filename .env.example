# Public build-time values only. Never place secrets in VITE_ variables.
# demo: local browser fixtures; api: runtime-validated HTTP endpoints.
VITE_DATA_SOURCE=demo
VITE_API_BASE_URL=/api

# Optional public origin, e.g. https://your-real-domain.example (no path/query/hash).
# Leave empty until deployment; canonical and absolute share-image URLs stay omitted.
VITE_SITE_URL=
